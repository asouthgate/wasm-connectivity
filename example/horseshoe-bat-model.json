{
  "name": "greater_horseshoe_bat",
  "inputs": {
    "dtm": {
      "type": "raster",
      "path": "data/resistance/dtm.tif"
    },
    "dsm": {
      "type": "raster",
      "path": "data/resistance/dsm.tif"
    },
    "landcover": {
      "type": "raster",
      "path": "data/resistance/lcm.tif"
    },
    "buildings": {
      "type": "vector",
      "path": "data/resistance/buildings.gpkg",
      "value_field": "value",
      "background": 0
    },
    "roads": {
      "type": "vector",
      "path": "data/resistance/roads.geojson",
      "value_field": "value",
      "background": 0
    },
    "rivers": {
      "type": "vector",
      "path": "data/resistance/empty.geojson",
      "value_field": "value",
      "background": 0
    },
    "generic": {
      "type": "vector",
      "path": "data/resistance/empty.geojson",
      "value_field": "value",
      "background": 0
    },
    "lamps": {
      "type": "points",
      "path": "data/resistance/empty.geojson",
      "height_field": "value"
    }
  },
  "layers": {
    "surfaces": {
      "op": "surface_heights",
      "terrain": "dtm",
      "surface": "dsm",
      "buildings": "buildings"
    },
    "road_res": {
      "input": "roads",
      "operations": [
        {
          "op": "distance",
          "units": "metres",
          "when_empty": "infinity"
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            200
          ],
          "base_range": [
            1,
            0.5
          ],
          "exponent": 5,
          "scale": 10,
          "offset": 0,
          "above": 0
        }
      ]
    },
    "river_res": {
      "input": "rivers",
      "operations": [
        {
          "op": "distance",
          "units": "metres",
          "when_empty": "infinity"
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            10
          ],
          "base_range": [
            0,
            1
          ],
          "exponent": 4,
          "scale": 2000,
          "offset": 0,
          "above": 2000
        }
      ]
    },
    "landscape_res": {
      "input": "landcover",
      "operations": [
        {
          "op": "round"
        },
        {
          "op": "discrete_map",
          "intervals": {
            "[1,1]": 2,
            "[2,2]": 5,
            "[3,3]": 6,
            "[4,8]": 4,
            "[9,10]": 3,
            "[11,11]": 4,
            "[12,12]": 8,
            "[13,18]": 7,
            "[19,19]": 4,
            "[20,21]": 8
          },
          "unmatched": "nodata"
        },
        {
          "op": "override",
          "where": {
            "input": "buildings",
            "interval": "(0,inf)"
          },
          "value": 8
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            8
          ],
          "base_range": [
            0,
            1
          ],
          "exponent": 5,
          "scale": 100,
          "offset": 0,
          "above": 100
        },
        {
          "op": "mask",
          "require_finite": [
            "surfaces.soft",
            "landcover"
          ]
        }
      ]
    },
    "unmanaged_hedge_res": {
      "input": "surfaces.soft",
      "operations": [
        {
          "op": "discrete_map",
          "intervals": {
            "(3,6)": 1
          },
          "unmatched": 0
        },
        {
          "op": "distance",
          "units": "metres",
          "when_empty": "infinity"
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            10
          ],
          "base_range": [
            0.125,
            0.625
          ],
          "exponent": 3,
          "scale": 22000,
          "offset": 1,
          "above": 5373.09375
        }
      ]
    },
    "tree_res": {
      "input": "surfaces.soft",
      "operations": [
        {
          "op": "discrete_map",
          "intervals": {
            "[6,inf)": 1
          },
          "unmatched": 0
        },
        {
          "op": "distance",
          "units": "metres",
          "when_empty": "infinity"
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            10
          ],
          "base_range": [
            0.25,
            0.75
          ],
          "exponent": 3,
          "scale": 22000,
          "offset": 1,
          "above": 9283.25
        }
      ]
    },
    "managed_hedge_res": {
      "input": "surfaces.soft",
      "operations": [
        {
          "op": "discrete_map",
          "intervals": {
            "(1,3)": 1
          },
          "unmatched": 0
        },
        {
          "op": "distance",
          "units": "metres",
          "when_empty": "infinity"
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            10
          ],
          "base_range": [
            0.5,
            1
          ],
          "exponent": 3,
          "scale": 22000,
          "offset": 1,
          "above": 22002
        }
      ]
    },
    "linear_res": {
      "op": "maximum",
      "inputs": [
        "unmanaged_hedge_res",
        "tree_res",
        "managed_hedge_res"
      ]
    },
    "irradiance": {
      "op": "irradiance",
      "lamps": "lamps",
      "terrain": "dtm",
      "soft_surface": "surfaces.soft",
      "hard_surface": "surfaces.hard",
      "cutoff_metres": 100,
      "sensor_height_metres": 0,
      "absorption": 0.5
    },
    "lamp_res": {
      "input": "irradiance",
      "operations": [
        {
          "op": "normalise",
          "method": "positive_maximum",
          "when_zero": 0
        },
        {
          "op": "power_response",
          "input_range": [
            0,
            1
          ],
          "base_range": [
            0,
            1
          ],
          "exponent": 1,
          "scale": 100000000,
          "offset": 0
        },
        {
          "op": "mask",
          "require_finite": [
            "surfaces.soft"
          ]
        }
      ]
    },
    "total_res": {
      "op": "sum",
      "inputs": [
        "road_res",
        "river_res",
        "landscape_res",
        "linear_res",
        "lamp_res",
        "generic"
      ]
    }
  },
  "output": "total_res"
}
